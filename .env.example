# Local standalone profile. Copy to .env; make dev-backend loads it.
RESPONSE_HTTP_ADDR=127.0.0.1:8080
RESPONSE_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
RESPONSE_SECURE_COOKIES=false

# Admission and payload protection defaults (positive integers only).
RESPONSE_CREATE_ROOMS_PER_SESSION=5
RESPONSE_CREATE_ROOMS_PER_IP=20
RESPONSE_JOINS_PER_SESSION=10
RESPONSE_JOINS_PER_IP=30
RESPONSE_WS_COMMANDS_PER_SECOND=20
RESPONSE_WS_COMMAND_BURST=40
RESPONSE_HTTP_BODY_BYTES=65536
RESPONSE_WS_FRAME_BYTES=32768
RESPONSE_JSON_DEPTH=16
