{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://response-online.local/schemas/gallery-evidence.schema.json",
  "title": "Response Online M1 gallery evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "source",
    "snapshotPath",
    "snapshotSha256",
    "captureMethod",
    "scope",
    "transferVerification",
    "ownerVerification"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceId": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["galleryUrl", "apiUrl", "checkedAt", "catalogVersion", "pageCount", "catalogCardCount"],
      "properties": {
        "galleryUrl": { "const": "https://response-game.ru/spoiler" },
        "apiUrl": { "type": "string", "pattern": "^https://response-league\\.ru/api/" },
        "checkedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "catalogVersion": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "pageCount": { "type": "integer", "minimum": 1 },
        "catalogCardCount": { "type": "integer", "minimum": 132 }
      }
    },
    "snapshotPath": { "const": "content/evidence/base-gallery-snapshot.json" },
    "snapshotSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "captureMethod": { "const": "official-json-api-no-ocr" },
    "scope": { "type": "string", "minLength": 1 },
    "transferVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "performedBy", "performedAt"],
      "properties": {
        "status": { "const": "source-matched" },
        "performedBy": { "type": "string", "minLength": 1 },
        "performedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "ownerVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "reviewedAt", "decision", "decisionSource"],
      "properties": {
        "status": { "const": "approved" },
        "reviewer": { "const": "dKorialstrasz" },
        "reviewedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "decision": { "type": "string", "minLength": 1 },
        "decisionSource": { "type": "string", "minLength": 1 }
      }
    }
  }
}
